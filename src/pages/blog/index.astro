---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmtDate = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const readingMinutes = (body: string | undefined) =>
  Math.max(1, Math.round((body?.split(/\s+/).length ?? 0) / 220));
---

<Base title="Writing" description="Notes on remote sensing, GIS and the software underneath them.">
  <div class="writing" style="padding-top:72px">
    <div class="sheet">
      <div class="idx-head halo tight">
        <h2>Writing</h2>
        <div class="tick">{posts.length} {posts.length === 1 ? 'post' : 'posts'} · RSS available</div>
      </div>
      <p class="idx-note halo tight">
        Things I ran into and had to work out. Mostly remote sensing, occasionally the tooling
        around it.
      </p>
      {posts.length ? (
        <div class="entries halo">
          {posts.map(p => (
            <a class="entry" href={`/blog/${p.id}`}>
              <span class="e-date">{fmtDate(p.data.date)}</span>
              <span class="e-title">{p.data.title}</span>
              <span class="e-len">{readingMinutes(p.body)} min</span>
            </a>
          ))}
        </div>
      ) : (
        <p class="idx-note halo tight">Nothing published yet.</p>
      )}
    </div>
  </div>
</Base>
